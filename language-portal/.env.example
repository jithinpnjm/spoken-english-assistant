# Copy to .env for local development; the server loads it automatically when NODE_ENV is not production. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview

# Local dev: Docusaurus runs on :3000 and calls this server on :8080.
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000

# Optional shared access code for AI practice (recommended when deployed publicly).
# PRACTICE_ACCESS_CODE=choose-a-long-random-string

# Optional abuse-protection tuning (defaults shown).
# CHAT_REQUESTS_PER_MINUTE=20
# TRANSCRIBE_REQUESTS_PER_MINUTE=20
# LIVE_SESSIONS_PER_HOUR=12
# LIVE_MAX_CONCURRENT_PER_IP=2
# LIVE_MAX_CONCURRENT_TOTAL=20
# LIVE_MAX_SESSION_SECONDS=600
