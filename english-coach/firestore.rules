rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function allowedEmail() {
      return request.auth != null
        && request.auth.token.email.lower() in ["jithinpnjm23@gmail.com", "sandrasibiss@gmail.com"];
    }
    function ownsUserDoc(userId) {
      return allowedEmail() && request.auth.uid == userId;
    }
    function ownsSession(sessionId) {
      return allowedEmail()
        && get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update, delete: if ownsUserDoc(userId);
    }

    match /sessions/{sessionId} {
      allow create: if allowedEmail() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if allowedEmail() && resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read, create, update, delete: if ownsSession(sessionId);
      }
      match /corrections/{correctionId} {
        allow read, create, update, delete: if ownsSession(sessionId);
      }
      match /evaluations/{evaluationId} {
        allow read, create, update, delete: if ownsSession(sessionId);
      }
    }

    match /profiles/{profileId} {
      // Both users are trusted — allow any allowedEmail() to read/write.
      // Avoids the resource==null edge case when the profile doesn't exist on first login.
      allow read, create, update, delete: if allowedEmail();

      match /mistakeMemory/{mistakeId} {
        allow read, create, update, delete: if allowedEmail();
      }
      match /dailyPlans/{dateId} {
        allow read, create, update, delete: if allowedEmail();
      }
      match /progressSummaries/{summaryId} {
        allow read, create, update, delete: if allowedEmail();
      }
    }
  }
}
