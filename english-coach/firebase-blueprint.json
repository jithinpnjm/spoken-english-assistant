{
  "entities": {
    "User": {
      "title": "User",
      "description": "Stores settings and details for users like Jithin and Sandra.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth User UID."
        },
        "name": {
          "type": "string",
          "description": "Name of the user."
        },
        "level": {
          "type": "string",
          "description": "English proficiency level option.",
          "enum": ["Beginner", "Intermediate", "Advanced"]
        },
        "highContrast": {
          "type": "boolean",
          "description": "Whether high contrast mode is active or not."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of profile creation."
        }
      },
      "required": ["uid", "name", "level", "createdAt"]
    },
    "Session": {
      "title": "Session",
      "description": "An interactive coach learning session.",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Unique identifier for the session."
        },
        "userId": {
          "type": "string",
          "description": "UID of the user who owns this session."
        },
        "userName": {
          "type": "string",
          "description": "The name of the user who own this session."
        },
        "title": {
          "type": "string",
          "description": "Context topic or date label for the session."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Session creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp."
        },
        "mode": {
          "type": "string",
          "description": "Current mode used in the session: writing or listening.",
          "enum": ["writing", "listening"]
        },
        "profileId": {
          "type": "string",
          "description": "The sub-profile ID (e.g., 'jithin' or 'sandra') this session belongs to."
        }
      },
      "required": ["sessionId", "userId", "userName", "title", "createdAt", "updatedAt", "mode", "profileId"]
    },
    "Message": {
      "title": "Message",
      "description": "A single text or spoken turn conversation item.",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "description": "Unique message document ID."
        },
        "sessionId": {
          "type": "string",
          "description": "The parent session ID."
        },
        "userId": {
          "type": "string",
          "description": "Associated user ID."
        },
        "sender": {
          "type": "string",
          "description": "The sender of the message.",
          "enum": ["user", "coach"]
        },
        "text": {
          "type": "string",
          "description": "The string content of the user input or coach feedback."
        },
        "grammarCorrection": {
          "type": "string",
          "description": "Correction details if the coach finds grammar, spelling or sentence structure errors."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when this message was sent/received."
        }
      },
      "required": ["messageId", "sessionId", "userId", "sender", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores details for active users."
    },
    "/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Stores interactive conversational sessions."
    },
    "/sessions/{sessionId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Subcollection under each interactive session for individual dialogue lines."
    }
  }
}
