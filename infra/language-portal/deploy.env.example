# Copy to deploy.env (git-ignored) and adjust. Secrets do NOT go here — they live in Secret Manager.
PROJECT_ID=my-personal-data-430607
REGION=asia-south1
SERVICE_NAME=language-portal
REPO_NAME=language-portal
IMAGE_NAME=language-portal
SERVICE_ACCOUNT_NAME=language-portal-runtime
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview

# Require the PRACTICE_ACCESS_CODE secret for AI practice (recommended for a public URL).
USE_ACCESS_CODE=true

# Optional: refuse to deploy unless this gcloud account is active.
# EXPECTED_GCLOUD_ACCOUNT=you@example.com

# Optional extra runtime env vars, comma-separated KEY=VALUE pairs.
# EXTRA_ENV_VARS=CHAT_REQUESTS_PER_MINUTE=20,LIVE_SESSIONS_PER_HOUR=12,LIVE_MAX_SESSION_SECONDS=600
